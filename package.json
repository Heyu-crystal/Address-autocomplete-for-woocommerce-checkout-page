{
	"name": "address-autocomplete-for-woocommerce",
	"version": "1.0.0",
	"private": true,
	"description": "Google address suggestions for the WooCommerce checkout (block and classic) and My Account addresses.",
	"author": "HeyU Jewellery",
	"license": "SEE LICENSE IN LICENSE",
	"repository": {
		"type": "git",
		"url": "https://github.com/heyu-crystal/address-autocomplete-for-wp-woocommerce-checkout-page.git"
	},
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"lint:js": "eslint assets/js tests tools",
		"test:unit": "node --test \"tests/unit/**/*.test.js\"",
		"test:e2e": "playwright test",
		"env:start": "wp-env start && npm run env:seed",
		"env:seed": "wp-env run tests-cli wp plugin activate address-autocomplete-for-woocommerce && wp-env run tests-cli wp eval-file wp-content/plugins/address-autocomplete-for-woocommerce/tests/e2e/setup/seed.php",
		"env:stop": "wp-env stop",
		"build:pot": "wp i18n make-pot . languages/address-autocomplete-for-woocommerce.pot --exclude=node_modules,vendor,tests,tools,build,test-results,playwright-report --slug=address-autocomplete-for-woocommerce --domain=address-autocomplete-for-woocommerce",
		"build:zip": "bash bin/build-zip.sh",
		"lint:php": "composer run lint",
		"lint": "npm run lint:js && npm run lint:php",
		"test": "npm run test:unit"
	},
	"devDependencies": {
		"@playwright/test": "1.56.1",
		"@wordpress/env": "^10.0.0",
		"@wordpress/eslint-plugin": "^27.0.0",
		"eslint": "^10.0.0",
		"prettier": "npm:wp-prettier@^3.9.6"
	}
}
